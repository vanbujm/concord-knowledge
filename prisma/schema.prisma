generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "typedSql"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

/// One wiki page. Attribution (title, sourceUrl, pageId) plus the facets used
/// for filtering (the wiki's own categories, plus the derived realm, sphere,
/// and seasons), and the fields that drive incremental sync (lastRevId +
/// contentHash). Full text lives in the child chunks.
model Document {
  id          String   @id @default(cuid())
  pageId      Int      @unique
  title       String
  sourceUrl   String
  lastRevId   Int
  contentHash String
  categories  String[]
  realm       String?
  sphere      String?
  seasons     String[]
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chunks      Chunk[]

  @@index([realm])
  @@index([sphere])
}

/// A retrieval unit: one section-aware slice of a Document. `embedding` and
/// `searchVector` are Postgres extension types Prisma cannot model natively,
/// so they are declared Unsupported and driven by raw SQL. `searchVector` is
/// turned into a generated tsvector column, and both get their indexes, in the
/// migration (Prisma cannot express generated columns or an HNSW index).
model Chunk {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal      Int
  headingPath  String
  text         String
  tokenCount   Int
  charStart    Int
  charEnd      Int
  embedding    Unsupported("vector(384)")?
  searchVector Unsupported("tsvector")?

  @@index([documentId])
}

/// One Winds-of-the-World entry (a linked sub-page) the ravens have processed.
/// A row is written whether or not it was posted. `announcedAt` null means the
/// entry was seen but not posted: either a first-run baseline of a Winds page,
/// or an entry that matched no keyword. That seen-only marker is what keeps a
/// first run from flooding the channel with a whole season's backlog.
model WindsAnnouncement {
  id               String    @id @default(cuid())
  windsPageId      Int
  windsTitle       String
  entryTitle       String
  season           String?
  persona          String?
  matchedScopes    String[]
  matchedKeywords  String[]
  announcedAt      DateTime?
  discordMessageId String?
  firstSeenAt      DateTime  @default(now())

  @@unique([windsPageId, entryTitle])
  @@index([windsPageId])
}

/// A registered keyword the ravens watch for. `scope` is the literal string
/// "general" to signal a band-wide keyword everyone shares, or a Discord user
/// id for a personal one. Discord user ids are all-digit snowflakes, so they
/// never collide with the word "general". One row per (scope, keyword).
model Interest {
  id        String   @id @default(cuid())
  guildId   String
  scope     String
  keyword   String
  createdAt DateTime @default(now())

  @@unique([guildId, scope, keyword])
  @@index([guildId])
}
