# Prisma Postgres connection (provisioned in CON-6 / M0-2).
# The app and ingestion read/write through this. Prisma Postgres provides a
# pooled connection string; bulk ingestion may use the direct string.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"

# Canonical wiki source, used for ingestion and for attribution deep-links.
CONCORD_WIKI_BASE_URL="https://wiki.concordlarp.com"

# Upstash Redis for per-IP rate limiting (CON-11 / M3, CON-12 / M4).
# Leave both blank in local dev: the limit then falls back to an in-process
# counter rather than switching off, so requests are still bounded.
#
# The deployment gets KV_REST_API_URL and KV_REST_API_TOKEN instead, injected by
# the Upstash marketplace integration. Either pair works; the code reads
# whichever is set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Discord ravens (Diceria & Ricordo) ---
# The bot application: token (posting + command registration), application id and
# public key (slash-command interactions), and the target channel + guild.
DISCORD_BOT_TOKEN=""
DISCORD_APP_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_CHANNEL_ID=""
DISCORD_GUILD_ID="1517374663188025455"

# Anthropic API, used by the ravens to judge relevance and write dispatches.
ANTHROPIC_API_KEY=""
# Optional model override; defaults to claude-opus-4-8. Set to claude-haiku-4-5
# for a cheaper run.
CONCORD_CROW_MODEL=""

# Public URLs for the raven embed-author icons (optional; no icon when unset).
DICERIA_AVATAR_URL=""
RICORDO_AVATAR_URL=""

# Jonathan's Discord user id, used only by the seed to load his personal
# keywords. Look it up once with the Discord MCP (get_user_id_by_name).
SEED_DISCORD_USER_ID=""
